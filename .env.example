# =============================================================================
# NEXA Resume Builder -- configuration template
# Copy to .env and fill in. NEVER commit the real .env.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM providers. At least one is required.
# They are tried in the order listed below; the first that responds wins, so an
# exhausted free-tier quota on one provider fails over to the next automatically.
# -----------------------------------------------------------------------------

# 1. HuggingFace router (primary)
HF_API_KEY=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# 2. Groq -- free tier, very fast, daily token caps. https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Google Gemini -- most generous free tier. https://aistudio.google.com/apikey
#    NOTE: Google trains on free-tier inputs. Resumes are candidate PII --
#    use a paid tier or Azure OpenAI before putting real candidate data through it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 4. Cerebras -- free tier. https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# 5. Azure OpenAI -- the enterprise option: no training on your data, Entra-native.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional explicit failover order, e.g. "gemini,huggingface,groq".
# Unset means: the order above, skipping any provider without a key.
LLM_PROVIDER_ORDER=

LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=120

# Set to false ONLY if a corporate TLS-inspecting proxy breaks certificate
# validation. This sends candidate PII over an unverified connection.
LLM_VERIFY_TLS=true

# -----------------------------------------------------------------------------
# Authentication (Microsoft Entra ID via Azure App Service Easy Auth)
# -----------------------------------------------------------------------------

# Local development only. MUST be false/absent in any deployed environment --
# it disables the sign-in requirement entirely.
ALLOW_ANONYMOUS_AUTH=true
DEV_USER_EMAIL=dev.user@insight.com

# Comma-separated tenant domains permitted to sign in. Empty = any authenticated user.
ALLOWED_EMAIL_DOMAINS=insight.com

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
BACKEND_URL=http://127.0.0.1:8000
MAX_UPLOAD_MB=10
UI_REQUEST_TIMEOUT=180
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Layout budgets (two-page document)
# Page 1 left pane is a table cell; if it outgrows the page the row splits
# across the page boundary and bleeds into the right pane. These caps prevent it.
# -----------------------------------------------------------------------------
MAX_SKILLS=12
MAX_CERTIFICATIONS=7
PROFILE_MAX_WORDS=70

# Page 2 capacity for PROFESSIONAL EXPERIENCE. Above this, projects collapse
# into company-level achievement bullets (6, then 5, 4, 3). All employers are
# always retained. Verify changes with: python tools/page_count.py out.docx
EXPERIENCE_LINE_BUDGET=40
EXPERIENCE_CHARS_PER_LINE=85

# Bullets requested per project -- the dominant driver of generation time.
# Lower values keep large resumes inside the HuggingFace gateway's 504 limit.
MAX_ACHIEVEMENTS_PER_COMPANY=5

# Employers shown in PROFESSIONAL EXPERIENCE, most recent first. Older roles are
# dropped rather than compressed, buying fuller achievements for recent ones.
MAX_COMPANIES=3
